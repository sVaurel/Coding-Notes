# _ready() runs when the node is ready.

func _ready() -> void:
	pass


# _process(delta) runs every frame.
# delta is the time since the previous frame.

func _process(delta: float) -> void:
	pass


# _physics_process(delta) runs during physics updates.
# Commonly used for movement and physics.

func _physics_process(delta: float) -> void:
	pass


# =============================================================================
# DELTA
# =============================================================================

# delta helps movement remain consistent across different frame rates.

# Example:
# position.x += speed * delta


# =============================================================================
# SIGNALS
# =============================================================================

# Signals allow nodes to communicate when something happens.

signal player_died


# Emit a signal:
# player_died.emit()

# Connect a signal:
# player_died.connect(_on_player_died)

func _on_player_died() -> void:
	print("Player died")


