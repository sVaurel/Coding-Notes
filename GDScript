# "Sword" in inventory


# =============================================================================
# DICTIONARIES
# =============================================================================

# Dictionaries store key-value pairs.

var player_data: Dictionary = {
	"health": 100,
	"level": 1,
	"name": "Player"
}

# Access a value.
# player_data["health"]

# Change a value.
# player_data["health"] = 50


# =============================================================================
# ENUMS
# =============================================================================

# Enums create named values.

enum PlayerState {
	IDLE,
	WALKING,
	RUNNING,
	JUMPING
}

var current_state: PlayerState = PlayerState.IDLE


