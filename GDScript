# =============================================================================
# GDSCRIPT NOTES / REFERENCE
# =============================================================================


# =============================================================================
# VARIABLES
# =============================================================================

# Variables store information.
var health: int = 100
var player_name: String = "Player"
var speed: float = 5.0
var is_alive: bool = true


# =============================================================================
# DATA TYPES
# =============================================================================

# int = whole numbers.
var score: int = 100

# float = numbers with decimals.
var movement_speed: float = 5.5

# String = text.
var message: String = "Hello"

# bool = true or false.
var is_running: bool = false

# Vector2 = two-dimensional coordinates or directions.
var direction_2d: Vector2 = Vector2.ZERO

# Vector3 = three-dimensional coordinates or directions.
var direction_3d: Vector3 = Vector3.ZERO


# =============================================================================
# CONSTANTS
# =============================================================================

# Constants cannot be changed after they are created.
const MAX_HEALTH: int = 100
const GRAVITY: float = 9.8


# =============================================================================
# OPERATORS
# =============================================================================

# Addition: +
# Subtraction: -
# Multiplication: *
# Division: /
# Remainder: %

var addition = 5 + 5
var subtraction = 10 - 5
var multiplication = 5 * 5
var division = 10 / 2
var remainder = 10 % 3

# += adds and assigns.
score += 1

# -= subtracts and assigns.
health -= 10


# =============================================================================
# COMPARISON OPERATORS
# =============================================================================

# == Equal
# != Not equal
# > Greater than
# < Less than
# >= Greater than or equal
# <= Less than or equal


# =============================================================================
# LOGICAL OPERATORS
# =============================================================================

# and = both conditions must be true.
# or = at least one condition must be true.
# not = reverses a boolean.

# Example:
# if health > 0 and is_alive:
#     pass


# =============================================================================
# FUNCTIONS
# =============================================================================

# Functions contain reusable instructions.

func say_hello() -> void:
	print("Hello")


# Parameters receive information passed into a function.

func take_damage(damage: int) -> void:
	health -= damage


# Default parameters have a value if none is provided.

func heal(amount: int = 10) -> void:
	health += amount


# Return values send information back from a function.

func add_numbers(a: int, b: int) -> int:
	return a + b


# =============================================================================
# CONDITIONALS
# =============================================================================

func check_health() -> void:
	if health <= 0:
		print("Dead")
	elif health < 50:
		print("Low health")
	else:
		print("Healthy")


# =============================================================================
# MATCH
# =============================================================================

func check_state(state: String) -> void:
	match state:
		"idle":
			print("Idle")
		"walking":
			print("Walking")
		_:
			print("Unknown state")


# =============================================================================
# LOOPS
# =============================================================================

# for repeats through a collection or range.

func loop_example() -> void:
	for i in range(10):
		print(i)


# while repeats while its condition is true.
# Be careful not to create an infinite loop.


